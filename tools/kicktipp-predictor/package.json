{
  "name": "kicktipp-predictor",
  "version": "1.0.0",
  "description": "Automatischer WM-Tipp-Bot für Kicktipp.de mit Claude AI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "predict": "ts-node src/index.ts",
    "predict:visible": "HEADLESS=false ts-node src/index.ts",
    "postinstall": "playwright install chromium --dry-run || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
